{
  "name": "zyntry-code",
  "displayName": "Zyntry Code",
  "description": "Run AI coding tasks in your open folder. Describe what you want in the sidebar; Zyntry plans, edits, and verifies. Free models included.",
  "version": "0.3.6",
  "publisher": "ZyntryCode",
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/devspak-s8/Zyntry-Code"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "main": "./extension.js",
  "activationEvents": ["onView:zyntry.dashboard"],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        { "id": "zyntry-sidebar", "title": "Zyntry", "icon": "media/zyntry.svg" }
      ]
    },
    "views": {
      "zyntry-sidebar": [
        { "type": "webview", "id": "zyntry.dashboard", "name": "Dashboard" }
      ]
    },
    "commands": [
      { "command": "zyntry.openDashboard", "title": "Zyntry: Open Dashboard" },
      { "command": "zyntry.createTask", "title": "Zyntry: Create Task" },
      { "command": "zyntry.approveTask", "title": "Zyntry: Approve / Reject Task" },
      { "command": "zyntry.runTask", "title": "Zyntry: Run Task (sync)" },
      { "command": "zyntry.streamTask", "title": "Zyntry: Run Task (stream)" },
      { "command": "zyntry.ingestRepo", "title": "Zyntry: Ingest Repo Snapshot" },
      { "command": "zyntry.createWorkspace", "title": "Zyntry: Create Workspace (local runner)" },
      { "command": "zyntry.startLocalRunner", "title": "Zyntry: Start Local Runner" },
      { "command": "zyntry.stopLocalRunner", "title": "Zyntry: Stop Local Runner" }
    ],
    "configuration": {
      "title": "Zyntry Code",
      "properties": {
        "zyntry.backendUrl": {
          "type": "string",
          "default": "https://code-api.zyntry.space",
          "description": "Zyntry Code service endpoint — ships pointed at the public deployment; set to http://localhost:8787 for local runs."
        },
        "zyntry.autoStartRunner": {
          "type": "boolean",
          "default": true,
          "description": "Start the local runner automatically when the extension activates, so file edits, terminal checks, and git delivery work without setup."
        },
        "zyntry.runnerPollSeconds": {
          "type": "number",
          "default": 3,
          "minimum": 1,
          "description": "How often the local runner polls for tool requests."
        },
        "zyntry.runnerMaxFiles": {
          "type": "number",
          "default": 200,
          "minimum": 1,
          "description": "Maximum number of files included in a repo snapshot."
        }
      }
    }
  }
}
